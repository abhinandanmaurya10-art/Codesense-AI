# Root environment variables for CodeSense AI deployment

# Backend
PORT=5001
NODE_ENV=production
BASE_URL=https://your-backend-domain.com
BACKEND_URL=https://your-backend-domain.com
MONGODB_URI=mongodb://<username>:<password>@host:port/codesense-ai
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=models/gemini-2.5-flash
FRONTEND_URL=https://your-frontend-domain.com

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://your-backend-domain.com/api/auth/github/callback

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-domain.com/api/auth/google/callback

# Frontend
VITE_API_BASE_URL=https://your-backend-domain.com/api
# For Vercel same-project deployment, use:
# VITE_API_BASE_URL=/api
