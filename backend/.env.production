# Server Configuration
PORT=5001
NODE_ENV=production
BACKEND_URL=https://your-production-domain.com

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/codesense-ai

# JWT Configuration
JWT_ACCESS_SECRET=change_to_strong_secret_key
JWT_REFRESH_SECRET=change_to_strong_secret_key
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Gemini AI Configuration
GEMINI_API_KEY=your_production_gemini_key
GEMINI_MODEL=models/gemini-2.5-flash

# Frontend URLs
FRONTEND_URL=https://your-production-domain.com

# GitHub OAuth
GITHUB_CLIENT_ID=your_production_github_id
GITHUB_CLIENT_SECRET=your_production_github_secret
GITHUB_CALLBACK_URL=https://your-production-domain.com/api/auth/github/callback

# Google OAuth
GOOGLE_CLIENT_ID=your_production_google_id
GOOGLE_CLIENT_SECRET=your_production_google_secret
GOOGLE_CALLBACK_URL=https://your-production-domain.com/api/auth/google/callback
