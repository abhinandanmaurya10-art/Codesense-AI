PORT=5001
BACKEND_URL=http://localhost:5001
BASE_URL=http://localhost:5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/codesense-ai
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro
FRONTEND_URL=http://localhost:5173
# If BACKEND_URL is set, callback URLs will be built automatically. Otherwise set provider-specific callback URLs.
# FRONTEND_URL should include the production frontend origin for CORS, comma separated if needed.

# GitHub OAuth app settings
# Create app at: https://github.com/settings/developers
# Redirect URI: http://localhost:5001/api/auth/github/callback (change host or port for production)
# If GITHUB_CALLBACK_URL is not set, BACKEND_URL will be used to build the callback.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5001/api/auth/github/callback

# Google OAuth app settings
# Create app at: https://console.developers.google.com/
# Redirect URI: http://localhost:5001/api/auth/google/callback (change host or port for production)
# If GOOGLE_CALLBACK_URL is not set, BACKEND_URL will be used to build the callback.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
