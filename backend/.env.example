PORT=5005
BACKEND_URL=http://localhost:5005
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/codesense-ai
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro
FRONTEND_URL=http://localhost:5173

# GitHub OAuth app settings
# Create app at: https://github.com/settings/developers
# Redirect URI: http://localhost:5001/api/auth/github/callback (change port if needed)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5001/api/auth/github/callback

# Google OAuth app settings
# Create app at: https://console.developers.google.com/
# Redirect URIs: http://localhost:5001/api/auth/google/callback (change port if needed)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
